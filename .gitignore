# Local working documents - kept in the working copy, not published with the repo.
# The review and the plan describe in-progress work and internal decisions.
# They stay on disk and out of history.
AGENTS.md
optimizations.md
plan.md

# Payload verification cache, written next to the exe at runtime.
.payload-ok
.payload-ok.tmp

# Build outputs - releases are built from a clean checkout of the tagged commit and attached on GitHub.
/Goldberg Patcher.exe
/_selftest.exe
/dist/

# Markdown is local-only, except the repo front page and Shibaberg (whose tree includes the
# steam_settings.EXAMPLE .md files build.ps1 embeds as payload).
*.md
!/README.md
# Shibaberg is a whole upstream tree (gbe_fork); keep it complete so rebases diff cleanly.
!/shibaberg/**/*.md

# Not needed to build or verify. Kept on disk, out of the repo.
/src/make_icon.ps1
/src/app.ico
# Shibaless: files build.ps1 does not compile, and fork-maintenance tooling.
/shibaless/**/*.csproj
/shibaless/**/Properties/
/shibaless/Shibaless.API/Model/ViewModelBase.cs
/shibaless/Shibaless.API/Model/NavigatedEventArgs.cs
/shibaless/Rename-FromUpstream.ps1
